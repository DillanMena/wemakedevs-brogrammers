# Every env var Debrief reads. Copy to .env and fill in; .env is gitignored.
# On the cluster these come from the Kubernetes Secret `app-credentials` instead.

# --- Elastic (ingest, API) ---
# Serverless project endpoint, e.g. https://<project>.es.<region>.gcp.elastic.cloud:443
ELASTIC_URL=
ELASTIC_API_KEY=

# --- Language model (ingest labels, API rerank + memo) ---
# anthropic | openai — only api/llm.py reads these
LLM_PROVIDER=
LLM_API_KEY=
LLM_RERANK_MODEL=
LLM_MEMO_MODEL=

# --- Tracing to Dash0 via OpenTelemetry (ingest, API) ---
# e.g. https://ingress.<region>.aws.dash0.com
OTEL_SERVICE_NAME=
OTEL_EXPORTER_OTLP_ENDPOINT=
# e.g. Authorization=Bearer <dash0-token>,Dash0-Dataset=default
OTEL_EXPORTER_OTLP_HEADERS=

# --- Demo cache (API) ---
# on: serve cached answers for the golden stacks from api/cache/
DEBRIEF_CACHE=
